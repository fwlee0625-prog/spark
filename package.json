{
  "name": "spark",
  "private": true,
  "version": "0.1.0",
  "license": "MIT",
  "description": "本机项目启动管理面板：创建、启停、日志、端口监控，并提供 MCP 接口供 AI 客户端调用。",
  "repository": {
    "type": "git",
    "url": "https://github.com/fwlee0625-prog/spark.git"
  },
  "packageManager": "pnpm@11.28.2",
  "engines": {
    "node": ">=20",
    "pnpm": ">=9"
  },
  "scripts": {
    "dev": "pnpm -r --parallel dev",
    "build": "pnpm --filter @spark/web build",
    "start": "pnpm build && pnpm --filter @spark/server start",
    "start:only": "pnpm --filter @spark/server start",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r --if-present test",
    "lint": "biome check .",
    "format": "biome check --write ."
  },
  "devDependencies": {
    "@biomejs/biome": "^2.3.4"
  }
}
